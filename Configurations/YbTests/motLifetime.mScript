%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1
dac: blue2dmot blue2dmotpower
dac: greenmot greenmotpower
dac: greenpushbeam greennarrowpushpower
dac: pushbeam bluepushpower
dac: blue3dmot blue3dmotpower
dac: bias1 bias1
dac: bias2 bias2
dac: biasz biasz


on: mako1
t += 10
off: mako1
t += 200
on: pixis_trg 
t += 2
off: pixis_trg
t += 1
on: pixis_trg
t += 2
off: pixis_trg
t += 5

