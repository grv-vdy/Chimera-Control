t += 1
off: lattice
off: greenmot
off: pushbeam
off: blue3dmot
dac: blue2dmot blue2dmotpower
off: nrshutter
off: greennarrow
off: blueimg
off: greenimg
off: blueimgshutter

dac: bias1 (bias1+biasx+biasy)
dac: bias2 (bias2-biasx+biasy)
dac: biasz (biasz+biaszoff)
dac: blue3dmot blue3dmotpower
dac: greenmot greenmotpower
dac: pushbeam bluepushpower
dac: blueimg 0
dac: greenimg 0

dac: latticeup 0
dac: nrlattice 0
off: nrlattice
off: lattice
%pulseon: dds0 0.1
%pulseon: dds1 0.1
pulseon: makoshutter 1 %close




t += 1

on: pushbeam
on: greenmot
on: blue3dmot


t += coreshellloadtime

repeat: 20
off: lattice
off: nrlattice
t += ssloadtime

dac: nrlattice nrlatdepth


off: pushbeam
off: blue3dmot
t += cooltime


on: nrlattice
on: lattice


t += overlaptime




%----------release mot


%dacramp: nrlattice 0 nrlatdepth nrlatramptime
%t += 2.5
%off: greenmot

off: greenmot

t += 0.001

on: latmove1
on: latmove2
%dac: blue3dmot blue3dmotlow
%t += blueshelllow





%t += (blueshellback-blueshelllow)
t += (blueshellback)
%dac: blue3dmot blue3dmotpower
on: pushbeam
on: blue3dmot
on: greenmot

t += (72-blueshellback)
dac: blueimg 1.7
t += 1


on: scopetrigger



off: latmove1
off: latmove2

on: mako2
on: blueimgshutter
t += 3

on: blueimg
t += blueimgtime
off: blueimg
off: mako2
off: scopetrigger
off: blueimgshutter

end




off: lattice
t += 20
on: lattice 

on: mako2
on: blueimgshutter
t += 1

on: blueimg
t += blueimgtime
off: blueimg
off: mako2


on: pixis_trg 
t += 1
off: pixis_trg
