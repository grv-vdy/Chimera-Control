%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1


dac: blue2dmot blue2dmotpower

dac: bias1 (bias1+biasx+biasy)
dac: bias2 (bias2-biasx+biasy)
dac: biasz (biasz+biaszoff)
dac: blue3dmot blue3dmotpower
dac: greenmot greenmotpower
dac: pushbeam bluepushpower

off: greenmot
off: blue3dmot
off: pushbeam
off: greenshutter
off: greenimg
off: blueimg
t += 100

on: greenmot
on: blue3dmot
on: mako1
t += 5
off: mako1

off: greenmot
off: blue3dmot
t += 10
on: pushbeam
on: blue3dmot
%t += 3000
on: greenmot


t += coreshellloadtime

off: pushbeam
off: blue3dmot
t += 1
on: mako1
t += 5
off: mako1

off: greenmot



t += 33
t += 3
on: pixis_trg 
t += 2
off: pixis_trg
t += 1
on: pixis_trg
t += 2
off: pixis_trg
t += 5

