dac: greenmot greenmotpower %greenmotpower

t += 1
on: pushbeam
on: blue3dmot

t += shellloadtime
t += 1
off: blue3dmot
off: pushbeam

t += 1
on: greennarrow
t += 2
on: lattice
dac: greenmot greenmotpowerlow
t += 20 %thermalize mot see 260225
off: greenmot
t += motreleasetime
on: greenmot
off: greennarrow
%dacramp: greenmot greenmotpowerlow greenmotpower 1
dac: greenmot greenmotpower %greenmotpower


t += 10
