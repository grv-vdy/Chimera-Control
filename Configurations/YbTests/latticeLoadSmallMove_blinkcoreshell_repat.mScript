t = 1

off: greenmot
off: pushbeam
off: blue3dmot
on: lattice
t += 100
dac: blue2dmot blue2dmotpower

dac: bias1 (bias1+biasx+biasy)
dac: bias2 (bias2-biasx+biasy)
dac: biasz (biasz+biaszoff)
dac: blue3dmot blue3dmotpower
dac: greenmot greenmotpower
dac: pushbeam bluepushpower
dac: blueimg 0


%pulseon: dds0 0.1
%pulseon: dds1 0.1
%
on: pushbeam
on: greenmot
on: blue3dmot


t += coreshellloadtime

off: lattice
off: pushbeam
off: blue3dmot


t += 1
on: greennarrow
