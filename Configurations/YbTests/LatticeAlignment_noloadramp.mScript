%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1
dac: blue2dmot blue2dmotpower
dac: blue3dmot blue3dmotpower
dac: greenmot greenmotpower
dac: greenpushbeam greennarrowpushpower
dac: pushbeam bluepushpower
dac: bias1 bias1
dac: bias2 bias2
dac: biasz biasz
t += 3000


dac: bias1 (bias1+biasx+biasy)
dac: bias2 (bias2-biasx+biasy)
dac: biasz (biasz+biaszoff)
t += 100

off: pushbeam
off: blue3dmot

dacramp: greenmot greenmotpower greenmotpowerlow 10
t += 3


%t += 1
% img 1

%t += 301

%t += 0.1

t += 10


%img 1
on: mako1
t += 22
off: mako1



t += 10
on: greenpush

t+= time

off: greenpush
t+= 101-time

t += 10

% img 2
on: mako1
t += 22
off: mako1

on: pushbeam
on: blue3dmot

dac: bias1 bias1
dac: bias2 bias2
dac: biasz biasz
t += 5000
t += 3
on: pixis_trg 
t += 2
off: pixis_trg
t += 1
on: pixis_trg
t += 2
off: pixis_trg
t += 5

