%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1

dac: blue3dmot 0.3
%dac: pushbeam 1
dac: blue2dmot 1.8300
dac: greenmot greennarrowpower
dac: greenpushbeam greenpushpower

%on: greennarrow
on: pushbeam
on: greenmot
on: mako1
t += 70
off: mako1
t += 10
off: pushbeam
t += 1
on: pushbeam
%on: blue3dmot

t += greenmotloadtime
%off: blue3dmot

%on: greennarrow
on: mako1
t += 70
off: mako1
%
%off: greennarrow
off: greenmot
off: blue3dmot
off: pushbeam

on: pixis_trg 
t += 2
off: pixis_trg
t += 1
on: pixis_trg
t += 2
off: pixis_trg
t += 5

t += 100

