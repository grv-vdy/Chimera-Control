%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1

dac: blue3dmot 0.3
%dac: pushbeam 1
dac: blue2dmot 1.8300
dac: greenmot 2
dac: greenpushbeam greenpushpower

on: pushbeam
on: greenmot
on: dds0
on: dds1
t += 10
off: dds0
off: dds1
on: mako1
t += 50
off: mako1
t += 10
off: pushbeam

dac: greenmot 0
t += 1
%on: pushbeam
%on: blue3dmot

t += 10

dac: greenmot 2

t += 100

dac: greenmot 0

%off: pushbeam
%off: blue3dmot

on: mako1
t += 50
off: mako1

t += 400

off: greenmot
off: blue3dmot
on: pixis_trg 
t += 2
off: pixis_trg
t += 1
on: pixis_trg
t += 2
off: pixis_trg
t += 5



