%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1

dac: blue3dmot blue3dmotpower
dac: pushbeam bluepushpower
dac: blue2dmot blue2dmotpower
dac: greenmot greenmotpower
dac: greenpushbeam greennarrowpushpower
dac: blueimg blueimgpower

dac: bias1 bias1
dac: bias2 bias2
dac: biasz biasz

off: blueimg
off: greenmot
off: pushbeam
off: blue3dmot
t += 10
on: pushbeam
on: greenmot

on: blue3dmot
t += coreshellloadtime

%mot rampdown
%dacramp: greenmot greenmotpower greenmotpowerlow 300
off: pushbeam
off: blue3dmot
%dacramp: greenmot greenmotpower 0.05 10

%t += 1
% img 1

%t += 301

%t += 0.1
off: greenmot

t += motreleasetime
on: mako1
t += 0.1
on: blueimg
t += 0.016
off: blueimg
t += 0.1
off: mako1

% make sure to destoroy atom
t += 0.3
on: blueimg
t += 20
off: blueimg
t += 0.3
% img 2
on: mako1
t += 0.1
on: blueimg
t += 0.016
off: blueimg
t += 0.1
off: mako1
t += 0.1

t += 21

on: mako1
t += 0.1

t += 0.016

t += 0.1
off: mako1
t += 0.1

t += 100

t += 3
on: pixis_trg 
t += 2
off: pixis_trg
t += 1
on: pixis_trg
t += 2
off: pixis_trg
t += 5



