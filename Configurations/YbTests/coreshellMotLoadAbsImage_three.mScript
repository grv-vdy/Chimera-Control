%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1


dac: blue2dmot blue2dmotpower
dac: blueimg blueimgpower
dac: bias1 (bias1+biasx+biasy)
dac: bias2 (bias2-biasx+biasy)
dac: biasz (biasz+biaszoff)
dac: blue3dmot blue3dmotpower
dac: greenmot greenmotpower
dac: pushbeam bluepushpower
on: lattice
off: greenmot
off: blue3dmot
off: pushbeam
off: blueimg
t += 100

on: pushbeam
on: blue3dmot
on: greenmot
t += coreshellloadtime

off: blue3dmot
off: pushbeam
%dac: blue3dmot blue3dmotpowerlow
t += 1
on: greennarrow
t += 2
dacramp: greenmot greenmotpower greenmotpowerlow 1
t += 1

%dac: greenmot greenmotpowerlow
t += 20 %thermalize mot see 260225
%t += 80

%release mot

off: greenmot
on: scopetrigger
t += motreleasetime
off: scopetrigger
on: mako1
t += 0.1
on: blueimg
t += 0.016
off: blueimg
t += 0.1
off: mako1

% make sure to destoroy atom
t += 1
on: blueimg
t += 20
off: blueimg
t += 1
% img 2
on: mako1
t += 0.1
on: blueimg
t += 0.016
off: blueimg
t += 0.1
off: mako1
t += 0.1

t += 21

on: mako1
t += 0.1

t += 0.016

t += 0.1
off: mako1
t += 0.1

t += 100

t += 3
on: pixis_trg 
t += 2
off: pixis_trg
t += 1
on: pixis_trg
t += 2
off: pixis_trg
t += 5



