t = 1
off: latmove1
off: latmove2
off: greenshutter
off: greenimgsh
on: greenimg
dac: blue2dmot blue2dmotpower

dac: bias1 (bias1+biasx+biasy)
dac: bias2 (bias2-biasx+biasy)
dac: biasz (biasz+biaszoff)

dac: blue3dmot blue3dmotpower
dac: greenmot greenmotpower
dac: pushbeam bluepushpower
dac: blueimg 0
dac: greenimg greenimgpower


pulseon: dds0 0.1
on: lattice
on: pushbeam
on: greenmot
on: blue3dmot
%
%% BG 
%dac: greenimg greenimgpower
%on: mako1
%t += 5
%on: greenimg
%t += greenimgtime
%off: greenimg
%dac: greenimg 0
%off: mako1

t += ssloadtime
off: blue3dmot
off: pushbeam
t += 3
on: greennarrow
t += 2
dacramp: greenmot greenmotpower greenmotpowerlow 1
t += 1
on: greenimgsh
t += latloadtime
off: greenmot
%% MOVE
