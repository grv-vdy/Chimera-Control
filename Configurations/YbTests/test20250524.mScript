%on: blue3dmot
on: pushbeam


t += blueshellback
%dac: blue3dmot blue3dmotpower
t += (150.27-blueshellblink-5-blueshellback)

%dac: greenimg greenimgpower
t += 3
on: mako1
on: d11
on: greenimg
t += 1
on: greenshutter
t += 3
t += greenimgtime
off: greenimg
dac: greenimg 0
off: greenimgsh

off: mako1
off: d11

dac: greenimg greenimgpowerthermalize

