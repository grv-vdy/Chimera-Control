pulseon: latmove2 1
off: greenimg
dac: greenimg 0
t += greenmotblink
off: greennarrow
dac: greenmot greenmotpower
on: greenmot
t += (blueshellblink-greenmotblink)


%dac: blue3dmot blue3dmotlow
