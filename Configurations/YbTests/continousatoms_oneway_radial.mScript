t = 1
off: latmove1
off: latmove2
off: greenshutter
off: greenimg
dac: blue2dmot blue2dmotpower

dac: bias1 (bias1+biasx+biasy)
dac: bias2 (bias2-biasx+biasy)
dac: biasz (biasz+biaszoff)

dac: blue3dmot blue3dmotpower
dac: greenmot greenmotpower
dac: pushbeam bluepushpower
dac: blueimg 0
dac: greenimg 0


pulseon: dds0 0.1
on: lattice
on: pushbeam
on: greenmot
on: blue3dmot
%
%% BG 
%dac: greenimg greenimgpower
%on: mako1
%t += 5
%on: greenimg
%t += greenimgtime
%off: greenimg
%dac: greenimg 0
%off: mako1

t += ssloadtime

off: blue3dmot
off: pushbeam
t += 3
dacramp: greenmot greenmotpower greenmotpowerlow 1
t += 1
t += latloadtime
off: greenmot
%% MOVE
pulseon: latmove1 1
pulseon: latmove2 1

t += blueshellblink

dac: blue3dmot blue3dmotlow
t += 3
on: blue3dmot
on: pushbeam
on: blue3dmot
on: greenmot
dac: greenmot greenmotpower
t += (284.55-blueshellblink)


on: mako1

dac: greenimg greenimgpower
t += 3
on: d11
on: greenimg
t += greenimgtime
off: greenimg
dac: greenimg 0

off: mako1
off: d11


t += 1
dac: blue3dmot blue3dmotpower



t += 1
on: pixis_trg 
t += 1
off: pixis_trg
t += 1
on: pixis_trg
t += 1
off: pixis_trg

