%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1
t += 1
off: lattice
off: greenmot
off: pushbeam
off: blue3dmot
dac: blue2dmot blue2dmotpower
off: nrshutter
off: greennarrow
off: blueimg
off: greenimg
off: blueimgshutter
off: absimg

dac: bias1 (bias1+biasx+biasy)
dac: bias2 (bias2-biasx+biasy)
dac: biasz (biasz+biaszoff)
dac: blue3dmot blue3dmotpower
dac: greenmot greenmotpower
dac: pushbeam bluepushpower
dac: blueimg 0
dac: greenimg 0
dac: absimage 0

dac: latticeup 0
dac: nrlattice 0
off: nrlattice
off: lattice
%pulseon: dds0 0.1
%pulseon: dds1 0.1
pulseon: makoshutter 1 %close




t += 1

dac: nrlattice 0.5


t += 100
on: pushbeam
on: greenmot
on: blue3dmot


t += coreshellloadtime


t += 1
off: pushbeam
off: blue3dmot
dac: nrlattice nrlatdepth
dac: absimage absimgpower
t += 3
on: nrlattice
on: lattice
on: scopetrigger

t += overlaptime




%----------release mot


off: greenmot

%

% -- Move
t += 0.001
%
on: latmove1
on: latmove2

t += 183
off: nrlattice
off: lattice
t += motreleasetime

%off: greenmot
on: mako1
t += 0.1
on: absimg
t += 0.05
