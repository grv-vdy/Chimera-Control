%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1

dac: blue3dmot 0.3
%dac: pushbeam 1
dac: blue2dmot blue2dmotpower
dac: greenmot greenmotpower
dac: greenpushbeam greennarrowpushpower
dac: blueimg bluepower
off: blueimg
off: greenmot
off: pushbeam
t += 10
on: pushbeam
on: greenmot

t += greenmotloadtime

%mot rampdown
%dacramp: greenmot greenmotpower greenmotpowerlow 300
off: pushbeam


