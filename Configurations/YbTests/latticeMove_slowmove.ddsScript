tone 0 (120-latdeviationload) 1 0
tone 1 (120+latdeviationload) 1 0

t += (coreshellloadtime-delayDDS)

t += 3

t += latloadtime

t += motreleasetime


ramp 0 (120-latdeviationload) (120-latdeviation) 1 latramptime 0
ramp 1 (120+latdeviationload) (120+latdeviation) 1 latramptime 0
t += (latmovetime)


ramp 0 (120-latdeviation) 120 1 latramptime 1
ramp 1 (120+latdeviation) 120 1 latramptime 1
%bnc 1
t += latpausetime + 10
%bnc 0
ramp 0 120 (120+latdeviation) 1 latramptime 0
ramp 1 120 (120-latdeviation) 1 latramptime 0

t += (latmovetime)

ramp 0 (120+latdeviation) (120+latdeviationload) 1 latramptime 0
ramp 1 (120-latdeviation)  (120-latdeviationload) 1 latramptime 0
