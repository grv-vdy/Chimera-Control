tone 0 120 1 0
tone 1 80 1 0

t += (coreshellloadtime-145)

t += 3

t += 20

t += motreleasetime

ramp 0 120 (120-latdeviation) 1 latramptime 0
ramp 1 80 (80+2*latdeviation) 1 latramptime 0

t += (latmovetime-2*latramptime)

ramp 0 (120-latdeviation) 120 1 latramptime 0
ramp 1 (80+2*latdeviation) 80 1 latramptime 0

t += latpausetime 

ramp 0 120 (120+latdeviation) 1 latramptime 0
ramp 1 80 (80-2*latdeviation) 1 latramptime 0

t += (latmovetime-2*latramptime)

ramp 0 (120+latdeviation) 120 1 latramptime 0
ramp 1 (80-2*latdeviation) 80 1 latramptime 0
