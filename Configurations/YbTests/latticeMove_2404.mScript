t = 1

off: greenmot
off: pushbeam
off: blue3dmot
t += 100
dac: blue2dmot blue2dmotpower

dac: bias1 (bias1+biasx+biasy)
dac: bias2 (bias2-biasx+biasy)
dac: biasz (biasz+biaszoff)
dac: blue3dmot blue3dmotpower
dac: greenmot greenmotpower
dac: pushbeam bluepushpower
dac: blueimg 0


pulseon: dds0 0.1
%pulseon: dds1 0.1
%
on: pushbeam
on: greenmot
on: blue3dmot


t += coreshellloadtime


off: pushbeam
off: blue3dmot
%motramp

%dacramp: bias1 (bias1+biasxfix) (bias1+biasx+biasy) 1
%dacramp: bias2 (bias2-biasxfix) (bias2-biasx+biasy) 1
%dacramp: biasz (biasz+biaszofffix) (biasz+biaszoff) 1
t += 1
on: greennarrow
t += 2
%dacramp: greenmot greenmotpower greenmotpowerlow 1
dac: greenmot greenmotpowerlow
t += 20 %thermalize mot see 260225
%t += 80

%release mot

off: greenmot
t += motreleasetime %for cleanup
dac: blueimg 0

%recapture mot
%
%on: scopetrigger 
on: d11
%pulseon: d11 1


t += (2*latramptime*nrep + latmovetime*nrep)
t += (latpausetime*nrep)
%on: blueimg

%off: blueimg
t += (2*latramptime*nrep + latmovetime*nrep)
t += (latpausetime*nrep)
t += 200
off: d11



%pulseon: scopetrigger 1
on: greenmot
off: greennarrow
%dacramp: greenmot greenmotpowerlow greenmotpower 1
dac: greenmot greenimgpower %greenmotpower


t += 1
dacramp: bias1 (bias1+biasx+biasy) (bias1+biasxfix) 1
dacramp: bias2 (bias2-biasx+biasy) (bias2-biasxfix) 1
dacramp: biasz (biasz+biaszoff) (biasz+biaszofffix) 1

t += 10

on: mako1
t += 250
off: mako1

off: greenmot
off: blue3dmot
dac: blueimg blueimgpower
on: blueimg

t += 100

off: blueimg
dac: blueimg 0
on: greenmot
t += 2
on: mako1
t += 250
off: mako1
t += 10
off: greenmot
t += 10


t += 33
t += 3
on: pixis_trg 
t += 2
off: pixis_trg
t += 1
on: pixis_trg
t += 2
off: pixis_trg
t += 5
