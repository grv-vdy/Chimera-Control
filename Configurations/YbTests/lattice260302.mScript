%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1

off: greenmot
dac: blue2dmot blue2dmotpower

dac: bias1 bias1
dac: bias2 bias2
dac: biasz biasz
dac: blue3dmot blue3dmotpower
dac: greenmot greenmotpower
dac: pushbeam bluepushpower
dac: blueimg blueimgpower

pulseon: dds0 0.1
%pulseon: dds1 0.1
%
on: pushbeam
on: greenmot
on: blue3dmot


t += coreshellloadtime

off: pushbeam
off: blue3dmot
%motramp

dacramp: bias1 bias1 (bias1+biasx+biasy) 1
dacramp: bias2 bias2 (bias2-biasx+biasy) 1
dacramp: biasz biasz (biasz+biaszoff) 1
t += 1
on: greennarrow
t += 2
%dacramp: greenmot greenmotpower greenmotpowerlow 1
dac: greenmot greenmotpowerlow
t += 20 %thermalize mot see 260225
%t += 80

%release mot

off: greenmot

t += motreleasetime


%%LATTICE MOVE

%on: scopetrigger 
%
%t += (2*latramptime)
%t += latmovetime
%
%%pulseon: blueimg 2
%t += 3
%on: blueimg
%t += latpausetime-6
%off: blueimg
%t += 3
%
%t += latmovetime
%t += (2*latramptime)
%
%off: scopetrigger


%recapture mot
%

on: greenmot
off: greennarrow
%dacramp: greenmot greenmotpowerlow greenmotpower 1
dac: greenmot greenmotpower
t += 1
dacramp: bias1 (bias1+biasx+biasy) bias1 1
dacramp: bias2 (bias2-biasx+biasy) bias2 1
dacramp: biasz (biasz+biaszoff) biasz 1

t += 10

on: mako1
t += 250
off: mako1

off: greenmot
off: blue3dmot
on: blueimg

t += 100

off: blueimg

on: greenmot
t += 2
on: mako1
t += 250
off: mako1
t += 10
off: greenmot
t += 10


t += 33
t += 3
on: pixis_trg 
t += 2
off: pixis_trg
t += 1
on: pixis_trg
t += 2
off: pixis_trg
t += 5
