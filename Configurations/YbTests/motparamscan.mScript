%%%%%%%%%%%%%%%%% Start With 1ms %%%%%%%%%%%%%%%%% 
t = 1

dac: blue3dmot blue3dmotpower
%dac: pushbeam 1
dac: blue2dmot blue2dmotpower
dac: greenmot greenmotpower
%dac: greenpushbeam greenpushpower
dac: greenpushbeam 0.2
dac: blueimg blueimgpower




on: greenmot
on: mako1
t += 50
off: mako1
off: greenmot

on: pushbeam
on: greenmot
on: blue3dmot

t += greenmotloadtime



off: pushbeam
off: blue3dmot

t += motreleasetime

on: mako1
t += 50
off: mako1

t += 10

off: greenmot

on: pixis_trg 
t += 2
off: pixis_trg
t += 1
on: pixis_trg
t += 2
off: pixis_trg
t += 5

