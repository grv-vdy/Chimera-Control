t = 1

off: greenmot
off: pushbeam
off: blue3dmot
off: blueimg
t += 100
dac: blue2dmot blue2dmotpower

dac: bias1 (bias1+biasx+biasy)
dac: bias2 (bias2-biasx+biasy)
dac: biasz (biasz+biaszoff)
dac: blue3dmot blue3dmotpower
dac: greenmot greenmotpower
dac: pushbeam bluepushpower
dac: blueimg 0


pulseon: dds0 0.1
%pulseon: dds1 0.1
%
on: pushbeam
on: greenmot
on: blue3dmot


t += coreshellloadtime


off: pushbeam
off: blue3dmot
%motramp

%dacramp: bias1 (bias1+biasxfix) (bias1+biasx+biasy) 1
%dacramp: bias2 (bias2-biasxfix) (bias2-biasx+biasy) 1
%dacramp: biasz (biasz+biaszofffix) (biasz+biaszoff) 1
t += 1
on: greennarrow
t += 2
%dacramp: greenmot greenmotpower greenmotpowerlow 1
dac: greenmot greenmotpowerlow
t += 20 %thermalize mot see 260225
%t += 80

%release mot


%t += motreleasetime %for cleanup


%recapture mot
%
%on: scopetrigger 
on: d11
%pulseon: d11 1


t += (2*latramptime + latmovetime)

%on: blueimg
t += latpausetime
t += 100
off: d11

%dac: blueimg 0

off: greenmot
t += 10



pulseon: blueshutter 1
t += waittime
on: mako1
t += 1
dac: blueimg blueimgpower
t += 1
on: blueimg
t += blueimagetime
off: blueimg
t += 10
off: mako1

t += 50

on: mako1
t += 1
t += 1
on: blueimg
t += blueimagetime
off: blueimg
t += 10
off: mako1
%
t += 33
pulseon: blueshutter 1
t += 3
on: pixis_trg 
t += 2
off: pixis_trg
t += 1
on: pixis_trg
t += 2
off: pixis_trg
t += 5

